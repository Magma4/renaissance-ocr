# Python / environments
.DS_Store
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.env
.venv/
venv/

# Large input data — not in version control
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
data/page_images/*
!data/page_images/.gitkeep
data/processed_pages/*
!data/processed_pages/.gitkeep
data/crops/*
!data/crops/.gitkeep

# Prediction outputs (generated by run_baseline.py)
data/predictions/*
!data/predictions/.gitkeep
!data/predictions/vlm_results_submission.jsonl

# Ground truth: ignore generated JSONL and raw docx/txt extracts
#   but KEEP the hand-edited transcription, reference, and README
data/ground_truth/extracted_txt/
data/ground_truth/raw_docx/

# Model outputs — checkpoints and fine-tuned weights are too large for git
outputs/crnn/*
!outputs/crnn/.gitkeep
outputs/trocr_finetuned/
outputs/debug/
outputs/gemini_eval/
outputs/sample_predictions/*
!outputs/sample_predictions/.gitkeep

# Misc large files / scratch
*.zip
Print/
Print.zip
NEXT_STEPS.md

# report/: version only Test II write-up + template (no proposals, PDFs, or Word)
report/*
!report/gsoc_test_2_results.md
!report/report_template.md

# Exported notebook PDFs (regenerate locally)
notebooks/*.pdf
